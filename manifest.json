{
  "manifest_version": 3,
  "name": "Obstructio Adscriptionum",
  "version": "0.3.0",
  "description": "Ad, tracker, popup, cosmetic and in-player ad blocker by noviciususor.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Obstructio Adscriptionum",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "core_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "anti-popup.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "cosmetic.css"
      ],
      "js": [
        "cosmetic.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youporn.com/*"
      ],
      "js": [
        "video-ad-skipper.js"
      ],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html"
}